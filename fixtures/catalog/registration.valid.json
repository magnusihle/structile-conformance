{
  "id": "protected.reference.block",
  "version": { "major": 1, "minor": 0 },
  "props": { "type": "object", "additionalProperties": false,
             "properties": { "label": { "type": "string" } }, "required": ["label"] },
  "slots": [{ "name": "content", "maxChildren": 16 }],
  "states": ["loading", "empty", "forbidden", "error", "ready"],
  "accessibility": { "role": "region", "keyboard": "tab", "focusOrder": "dom", "labelledBy": "label" },
  "dataNeeds": [{ "resource": "records", "fields": ["id"] }],
  "permissions": ["records.read"],
  "cost": { "staticWeight": 1, "maxRows": 100 }
}
