{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/platform/evidence.schema.json",
  "title": "Protected conformance evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evidenceId", "testId", "requirementIds", "status",
    "candidate", "runner", "environment", "startedAt", "finishedAt",
    "exitCode", "measurements", "artifacts", "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,200}$" },
    "testId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" },
    "requirementIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" }
    },
    "status": { "enum": ["passed", "failed", "skipped", "timed-out", "error"] },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commitSha", "dirty"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "dirty": { "const": false }
      }
    },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "imageDigest", "testSourceDigest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "testSourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "configDigest"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "configDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "region": { "type": "string" },
        "hardware": { "type": "string" },
        "seed": { "type": ["integer", "string"] }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "exitCode": { "type": "integer" },
    "measurements": { "type": "object", "additionalProperties": { "type": ["number", "integer", "string", "boolean"] } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["ciRunId", "workflowIdentity", "attestationRef"],
      "properties": {
        "ciRunId": { "type": "string", "minLength": 1 },
        "workflowIdentity": { "type": "string", "minLength": 1 },
        "attestationRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
